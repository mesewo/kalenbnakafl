# Runtime mode; use production behind HTTPS, development for local HTTP
APP_ENV=development

# PostgreSQL connection settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=kalenbnakafl

# API security; use at least 32 random characters
JWT_SECRET=replace-with-at-least-32-random-characters
# Must match each public site origin exactly (scheme + host, no path or trailing slash); write Origin checks use this allowlist.
CORS_ORIGINS=http://localhost:3000

# Optional first-admin bootstrap; set both together on first startup.
# The password needs at least 12 characters, at most 72 UTF-8 bytes, must not be common,
# and must not contain the bootstrap email or the Administrator name.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=use-a-long-random-bootstrap-passphrase

# Runtime settings
PORT=8080
# Frontend API origin: used during static generation and read per request by the runtime API proxy.
# Use an internal Compose URL locally or the full https:// origin of a hosted API (for example Render).
API_INTERNAL_URL=http://api:8080
DATABASE_URL=postgres://postgres:replace-with-a-long-random-password@db:5432/kalenbnakafl?sslmode=disable
UPLOAD_DIR=/data/uploads
MEDIA_MAX_MB=50
DB_CONNECT_RETRIES=8
# Trusted proxy CIDRs (Compose default is its isolated 172.21.0.0/24 network).
TRUSTED_PROXIES=172.21.0.0/24
# Apply embedded Goose migrations before serving (enabled by default in development Compose).
MIGRATE_ON_START=true
