# Runtime mode; use production behind HTTPS, development for local HTTP
APP_ENV=development

# PostgreSQL connection settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=kalenbnakafl

# API security; use at least 32 random characters
JWT_SECRET=replace-with-at-least-32-random-characters
# Must match each public site origin exactly (scheme + host, no path or trailing slash); write Origin checks use this allowlist.
CORS_ORIGINS=http://localhost:3000

# Optional first-admin bootstrap; set both together on first startup.
# The password needs at least 12 characters, at most 72 UTF-8 bytes, must not be common,
# and must not contain the bootstrap email or the Administrator name.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=use-a-long-random-bootstrap-passphrase

# Runtime settings
PORT=8080
# Frontend API origin: used during static generation and read per request by the runtime API proxy.
# Use an internal Compose URL locally or the full https:// origin of a hosted API (for example Render).
API_INTERNAL_URL=http://api:8080
# API-to-frontend ISR invalidation; the same secret is set on both Compose services.
FRONTEND_REVALIDATE_URL=http://frontend:3000/_revalidate
REVALIDATE_SECRET=replace-with-a-long-random-shared-secret
DATABASE_URL=postgres://postgres:replace-with-a-long-random-password@db:5432/kalenbnakafl?sslmode=disable
UPLOAD_DIR=/data/uploads
MEDIA_MAX_MB=50
# Media storage: local disk by default, or s3 for a private S3-compatible bucket.
STORAGE_DRIVER=local
# For local MinIO: docker compose --profile s3 up -d minio, create the bucket
# in http://localhost:9001, then set STORAGE_DRIVER=s3 and keep these defaults.
# The sample MinIO credentials below are local-development credentials only.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
# For Backblaze B2, set endpoint to https://s3.<region>.backblazeb2.com,
# S3_REGION to that region, bucket to a private B2 bucket, and credentials to
# a B2 application key ID and application key.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=kalenbnakafl-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_PATH_STYLE=true
DB_CONNECT_RETRIES=8
DB_MAX_OPEN_CONNS=5
DB_MAX_IDLE_CONNS=2
# Trusted proxy CIDRs (Compose default is its isolated 172.21.0.0/24 network).
TRUSTED_PROXIES=172.21.0.0/24
# Only enable forwarded-client-IP trust when the API receives platform IPs
# through the authenticated Next.js proxy. Never trust raw X-Forwarded-For.
TRUST_FORWARDED_HEADERS=false
FORWARDED_HEADERS_SECRET=
# Apply embedded Goose migrations before serving (enabled by default in development Compose).
MIGRATE_ON_START=true

# Optional demo seed/reset credentials; keep passwords in deployment secrets, never in git.
DEMO_EDITOR_EMAIL=
DEMO_EDITOR_PASSWORD=
DEMO_VOLUNTEER_EMAIL=
DEMO_VOLUNTEER_PASSWORD=
